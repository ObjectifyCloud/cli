# Objectify CLI — Local Development Environment
# Copy this file to .env and fill in your values.

# API base URL (defaults to https://api.objectify.cloud)
OBJECTIFY_API_URL=https://api.objectify.cloud

# Authentication (use one of the following)
# OBJECTIFY_API_KEY=obj_your_api_key_here
# OBJECTIFY_ADMIN_KEY=your_admin_key_here
